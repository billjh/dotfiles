# Theme and font
theme = Ayu
font-family = Lilex Nerd Font Mono
font-size = 14

# Background
background-opacity = 0.8
background-blur = 20
window-colorspace = display-p3

# Padding
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Splits
split-divider-color = #686868
unfocused-split-opacity = 0.5
keybind = super+e=new_split:down
keybind = super+shift+e=new_split:right
keybind = super+arrow_left=goto_split:left
keybind = super+arrow_right=goto_split:right
keybind = super+arrow_up=goto_split:up
keybind = super+arrow_down=goto_split:down

# Windows and tabs
working-directory = home
tab-inherit-working-directory = false
window-save-state = always
quit-after-last-window-closed = true

# Mouse
focus-follows-mouse = true
mouse-hide-while-typing = true

# Scrollback
scrollback-limit-bytes = unlimited
